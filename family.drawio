<mxfile host="dsh" agent="draw-the-family.py"><diagram id="family" name="The family"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="3400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n0" value="&lt;b&gt;Железо машины: что она о себе сообщает и что молчит&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;check-hardware/SKILL.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="330" height="84" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;Какие показания читаются, а какие возвращаются пустыми&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;check-hardware/references/readings.md&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="330" height="84" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Собирает показания железа, ничего не меняя&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;check-hardware/scripts/collect.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="330" height="84" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Как написать скилл: ворота, проверка, испытание&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/SKILL.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="184" width="330" height="84" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Как скиллы портятся: частые ошибки написания&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/references/anti-patterns.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="184" width="330" height="84" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Что взято у других скиллов и что дало испытание&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/references/borrowed-practices.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="268" width="330" height="84" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Как измерить, работает ли скилл&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/references/eval-protocol.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="352" width="330" height="84" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Где харнесс ищет скиллы — семь корней&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/references/harness-locations.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="436" width="330" height="84" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Когда проверку нельзя провести на этой машине&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/references/simulating-a-test.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="520" width="330" height="84" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Проверка скилла, чей тест лежит вне машины&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/references/testing-a-skill.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="604" width="330" height="84" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Граф семьи: метки на рёбрах и четыре неверные версии&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/references/the-family-graph.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="688" width="330" height="84" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;Проверяет скилл: шапку, бюджет в токенах, ссылки&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/scripts/check-skill.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="184" width="330" height="84" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;Ловит устаревший перевод по отпечатку источника&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/scripts/check-translations.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="268" width="330" height="84" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;Рисует структуру семьи в формате draw.io&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/scripts/draw-the-family.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="352" width="330" height="84" as="geometry" /></mxCell><mxCell id="n14" value="&lt;b&gt;create-a-skill/scripts/family-glossary.json&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="436" width="330" height="62" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b&gt;Строит граф: что на что ссылается и как это доказано&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/scripts/graph-skills.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="330" height="84" as="geometry" /></mxCell><mxCell id="n16" value="&lt;b&gt;Тесты проверяльщика скиллов&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;create-a-skill/scripts/test-check-skill.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="604" width="330" height="84" as="geometry" /></mxCell><mxCell id="n17" value="&lt;b&gt;Как устроить награду для обучения: что мерить и как оценивать&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;design-a-reward/SKILL.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="268" width="330" height="84" as="geometry" /></mxCell><mxCell id="n18" value="&lt;b&gt;Границы поиска и размер шага&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;design-a-reward/references/bounds-and-steps.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="772" width="330" height="84" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b&gt;Кривая не растёт: что проверять по порядку&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;design-a-reward/references/diagnosing-a-flat-curve.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="856" width="330" height="84" as="geometry" /></mxCell><mxCell id="n20" value="&lt;b&gt;Правила, которым награда обязана удовлетворять&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;design-a-reward/references/rules-of-a-reward.md&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="940" width="330" height="84" as="geometry" /></mxCell><mxCell id="n21" value="&lt;b&gt;Проверяет награду вырожденными и враждебными стратегиями&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;design-a-reward/scripts/probe-reward.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="688" width="330" height="84" as="geometry" /></mxCell><mxCell id="n22" value="&lt;b&gt;draw-a-diagram/SKILL.md&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="352" width="330" height="62" as="geometry" /></mxCell><mxCell id="n23" value="&lt;b&gt;draw-a-diagram/references/the-drawio-format.md&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1024" width="330" height="62" as="geometry" /></mxCell><mxCell id="n24" value="&lt;b&gt;draw-a-diagram/scripts/check-drawio.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="772" width="330" height="62" as="geometry" /></mxCell><mxCell id="n25" value="&lt;b&gt;Искать готовый скилл, прежде чем писать свой&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;find-a-skill/SKILL.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="436" width="330" height="84" as="geometry" /></mxCell><mxCell id="n26" value="&lt;b&gt;Как испытать чужой скилл на своём случае&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;find-a-skill/references/trialling-an-external-skill.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1108" width="330" height="84" as="geometry" /></mxCell><mxCell id="n27" value="&lt;b&gt;Два правила про чужой контент и что сканер не видит&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;find-a-skill/references/untrusted-content.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1192" width="330" height="84" as="geometry" /></mxCell><mxCell id="n28" value="&lt;b&gt;Что взято у других скиллов и чем это подтверждено&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;find-a-skill/references/what-was-taken.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1276" width="330" height="84" as="geometry" /></mxCell><mxCell id="n29" value="&lt;b&gt;Сканирует скачанное до того, как это прочитают&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;find-a-skill/scripts/check-external-skill.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="856" width="330" height="84" as="geometry" /></mxCell><mxCell id="n30" value="&lt;b&gt;Ищет по семи корням харнесса и по GitHub&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;find-a-skill/scripts/scout.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="940" width="330" height="84" as="geometry" /></mxCell><mxCell id="n31" value="&lt;b&gt;Суд над скиллом: обвинение, защита, приговор&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;judge-a-skill/SKILL.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="330" height="84" as="geometry" /></mxCell><mxCell id="n32" value="&lt;b&gt;Три суда и что каждый нашёл&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;judge-a-skill/references/three-hearings.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1360" width="330" height="84" as="geometry" /></mxCell><mxCell id="n33" value="&lt;b&gt;Ведёт протокол суда и отказывает обвинению без улики&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;judge-a-skill/scripts/hearing.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1024" width="330" height="84" as="geometry" /></mxCell><mxCell id="n34" value="&lt;b&gt;Водить интерфейс мышью и клавиатурой, когда другого входа нет&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/SKILL.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="604" width="330" height="84" as="geometry" /></mxCell><mxCell id="n35" value="&lt;b&gt;Разбор случая, где учить оказалось нечего&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/references/a-worked-example.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1444" width="330" height="84" as="geometry" /></mxCell><mxCell id="n36" value="&lt;b&gt;Сначала дерево доступности, потом пиксели&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/references/accessibility-first.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1528" width="330" height="84" as="geometry" /></mxCell><mxCell id="n37" value="&lt;b&gt;Что взято у 105 репозиториев и что отвергнуто&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/references/borrowed-practices.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1612" width="330" height="84" as="geometry" /></mxCell><mxCell id="n38" value="&lt;b&gt;Калибровка мыши, два прибора, разные слепые зоны&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/references/calibrating-input.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1696" width="330" height="84" as="geometry" /></mxCell><mxCell id="n39" value="&lt;b&gt;Слой ввода и запись демонстрации человеком&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/references/input-and-demonstration.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1780" width="330" height="84" as="geometry" /></mxCell><mxCell id="n40" value="&lt;b&gt;Как измерить окно, чтобы клик попал&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/references/measuring-a-window.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1864" width="330" height="84" as="geometry" /></mxCell><mxCell id="n41" value="&lt;b&gt;Ловушки ввода, окон и координат&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/references/traps.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1948" width="330" height="84" as="geometry" /></mxCell><mxCell id="n42" value="&lt;b&gt;Настоящая протяжка: нажать, вести шагами, отпустить&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/scripts/drag.ps1&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1108" width="330" height="84" as="geometry" /></mxCell><mxCell id="n43" value="&lt;b&gt;Где интерфейс сдвинулся — окно сравнения&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/scripts/find_shift.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1192" width="330" height="84" as="geometry" /></mxCell><mxCell id="n44" value="&lt;b&gt;Бандит: находит неизвестную деталь интерфейса&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/scripts/learn-an-interface.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1276" width="330" height="84" as="geometry" /></mxCell><mxCell id="n45" value="&lt;b&gt;Игра-калибровка: девять жестов и чек-лист&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/scripts/mouse_game.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1360" width="330" height="84" as="geometry" /></mxCell><mxCell id="n46" value="&lt;b&gt;Хук мыши: каждое нажатие с координатами&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/scripts/mousewatch.ps1&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1444" width="330" height="84" as="geometry" /></mxCell><mxCell id="n47" value="&lt;b&gt;Траектория числами: где рука замерла&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/scripts/read_demo.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1528" width="330" height="84" as="geometry" /></mxCell><mxCell id="n48" value="&lt;b&gt;Запись экрана: кадры, курсор с кнопками, события мыши&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/scripts/screenwatch.ps1&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1612" width="330" height="84" as="geometry" /></mxCell><mxCell id="n49" value="&lt;b&gt;Как выглядит сдвиг: полоса экрана из многих кадров&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;learn-an-interface/scripts/stack_column.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1696" width="330" height="84" as="geometry" /></mxCell><mxCell id="n50" value="&lt;b&gt;Работа с ВК: прочитать сообщество прежде чем писать&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/SKILL.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="688" width="330" height="84" as="geometry" /></mxCell><mxCell id="n51" value="&lt;b&gt;Что отвечает каждый метод, включая коды-обманки&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/references/api-errors.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="2032" width="330" height="84" as="geometry" /></mxCell><mxCell id="n52" value="&lt;b&gt;Четыре слоя: границы, функции, смысл, просьбы&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/references/capabilities.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="2116" width="330" height="84" as="geometry" /></mxCell><mxCell id="n53" value="&lt;b&gt;Настройки сообщества: что в API, что только на странице&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/references/community-settings.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="2200" width="330" height="84" as="geometry" /></mxCell><mxCell id="n54" value="&lt;b&gt;Правка поста через интерфейс, где API бессилен&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/references/editing-a-post-in-the-interface.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="2284" width="330" height="84" as="geometry" /></mxCell><mxCell id="n55" value="&lt;b&gt;Поток событий: страница и API сходятся&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/references/events.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="2368" width="330" height="84" as="geometry" /></mxCell><mxCell id="n56" value="&lt;b&gt;Типографика русского текста для постов&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/references/typography-ru.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="2452" width="330" height="84" as="geometry" /></mxCell><mxCell id="n57" value="&lt;b&gt;Публикует пост через ворота подтверждения&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/scripts/post.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1780" width="330" height="84" as="geometry" /></mxCell><mxCell id="n58" value="&lt;b&gt;Проверяет ключ и права до первой записи&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/scripts/preflight.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1864" width="330" height="84" as="geometry" /></mxCell><mxCell id="n59" value="&lt;b&gt;Тесты вычитки типографики&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/scripts/test-typo-lint.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1948" width="330" height="84" as="geometry" /></mxCell><mxCell id="n60" value="&lt;b&gt;Вычитывает кавычки, тире и неразрывные пробелы&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-vk/scripts/typo_lint.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="2032" width="330" height="84" as="geometry" /></mxCell><mxCell id="n61" value="&lt;b&gt;Работа с Windows: скрипты без тихих отказов&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-windows/SKILL.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="772" width="330" height="84" as="geometry" /></mxCell><mxCell id="n62" value="&lt;b&gt;Ловушки PowerShell, ввода, окон, файлов и раскладки&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-windows/references/traps.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="2536" width="330" height="84" as="geometry" /></mxCell><mxCell id="n63" value="&lt;b&gt;Расшифровывает текст, набранный в чужой раскладке&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-windows/scripts/fix-layout.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="2116" width="330" height="84" as="geometry" /></mxCell><mxCell id="n64" value="&lt;b&gt;Проверка перед кликом: цель, фокус, кодировка&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;manage-windows/scripts/preflight.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;· назван, но не связан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="2200" width="330" height="84" as="geometry" /></mxCell><mxCell id="n65" value="&lt;b&gt;Тесты расшифровщика раскладки&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quo